# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jumpto

# Redis. In production the Vercel API and the Render worker must point at the
# SAME broker. Render's managed Redis is private (unreachable from Vercel), so
# use an internet-reachable Redis (e.g. Upstash free tier) here and on Vercel.
# REDIS_URL=redis://default:<password>@<region>.upstash.io:6379

# Celery broker transport: "redis" (default) or "rabbitmq".
# QUEUE_PROVIDER=redis

# RabbitMQ connection URL, used when QUEUE_PROVIDER=rabbitmq. The backend and
# the worker must point at the SAME RabbitMQ instance.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Environment
ENVIRONMENT=development

# Vercel Blob read-write token (from the project's Blob store). The worker
# also needs the same token: it uploads produced video downloads there and
# this API deletes them once the client has fetched them.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# External Calls Gate (set to "true" to enable live yt-dlp/Assembly.ai calls)
LIVE_EXTERNAL_CALLS=false

# Transcript Mode: "real" or "fake" (fake uses deterministic test data)
TRANSCRIPT_MODE=real

# ── Accounts, sessions and history ────────────────────────────────────────
# Set CSRF_TOKEN to a long random string in every deployed environment. It is
# not a credential: it may be baked into the frontend bundle, and it only has
# effect alongside the HttpOnly session cookie.
# CSRF_TOKEN=change_me_to_a_long_random_string

# Shared secret for transactional mail (verification and password reset).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587            # 587 = STARTTLS (Gmail), 465 = implicit TLS (Hostinger)
# SMTP_USE_SSL=            # leave unset to infer from the port; set true/false to force
# SMTP_USER=you@gmail.com  # the FULL address, not just the local part
# SMTP_APP_PASSWORD=your_mailbox_password
# EMAIL_FROM=you@gmail.com
# Origin the links inside emails are built from. Unset, it follows
# ENVIRONMENT: http://localhost:5173 in development, https://qfza.app otherwise.
# A loopback or plain-http value is refused at boot when ENVIRONMENT=production,
# because every reset and verification mail would then carry a dead link.
# PUBLIC_SITE_URL=https://qfza.app

# Google sign-in. The web client sends the ID token Google's button already
# signed, so the backend needs the client id and no client secret. Left unset,
# Google sign-in is refused outright rather than half-working.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Reverse proxies allowed to set X-Forwarded-For. The login rate limiter keys on
# the client address, so a header believed from anywhere would let a caller pick
# their own key and guess passwords without limit. Leave empty when the app is
# reached directly, and name the proxy's addresses or ranges when it is not.
# TRUSTED_PROXY_NETWORKS=10.0.0.1,172.16.0.0/12
PUBLIC_SITE_URL=http://localhost:5173/
